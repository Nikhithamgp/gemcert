# ---------------------------------------------------------------
# Gemstone Certificate System — environment configuration
# Copy to .env (local) or set in your hosting dashboard (production).
# Never commit real values.
# ---------------------------------------------------------------

# PostgreSQL connection string. URL-encode special characters in the password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/gemcert?schema=public"

# Optional: separate database used by integration tests (npm test). Tests that
# need a database are skipped when this is not set. It is wiped by the tests.
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/gemcert_test?schema=public"

# Absolute public URL encoded into QR codes. Can be overridden in Lab Settings.
# Production: MUST be https and publicly reachable, e.g. https://verify.yourlab.com
# Local dev: http://localhost:3000 (QR will only work on this PC), or your LAN IP
# such as http://192.168.1.20:3000 to test with a phone on the same Wi-Fi.
PUBLIC_BASE_URL="http://localhost:3000"

# Default certificate number prefix (Lab Settings can change it). Numbers look like SLN-2026-000001.
CERTIFICATE_PREFIX="SLN"

# Initial admin account, used ONLY by `npm run admin:bootstrap`.
# Password must be at least 12 characters. Remove it from .env after bootstrapping.
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Lab Administrator"
ADMIN_PASSWORD=""

# Image storage: "local" (dev only — files in LOCAL_STORAGE_DIR) or "s3" (any S3-compatible service).
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"

# S3-compatible storage (Cloudflare R2, AWS S3, Backblaze B2, MinIO...). Required when STORAGE_DRIVER=s3.
# Cloudflare R2 example endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com  region: auto
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Max upload size for photos/logos, in megabytes.
MAX_UPLOAD_MB="8"

# Session lifetime in hours.
SESSION_TTL_HOURS="12"
